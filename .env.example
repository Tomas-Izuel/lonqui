# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# En local salen de `npx supabase status` (el stack corre en 127.0.0.1:54321).
# En producción, del dashboard del proyecto hosted (región sa-east-1).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Bypassea RLS. Solo servidor, solo para crear usuarios de Auth y jobs sin
# sesión. NUNCA para escrituras del dominio: la auditoría quedaría sin autor.
SUPABASE_SECRET_KEY=

# Origen del sitio. Se usa para armar links absolutos (reseteo de contraseña).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Resend (opcional en la Fase 1)
# ---------------------------------------------------------------------------
# Los mails de Auth (reseteo de contraseña, invitación) NO salen desde acá:
# salen por el SMTP que se configura en el dashboard de Supabase (usuario
# `resend`, contraseña = esta misma API key). Estas variables son para mails
# propios de la app, que en la Fase 1 no hay.
# El remitente tiene que estar en un dominio verificado en Resend: el del club.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Club Naranja y Blanco
