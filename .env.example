# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# En local salen de `npx supabase status` (el stack corre en 127.0.0.1:54321).
# En producción, del dashboard del proyecto hosted (región sa-east-1).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Bypassea RLS. Solo servidor, solo para crear usuarios de Auth y jobs sin
# sesión. NUNCA para escrituras del dominio: la auditoría quedaría sin autor.
SUPABASE_SECRET_KEY=

# Origen del sitio. Se usa para armar links absolutos (reseteo de contraseña).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Admin de desarrollo (solo local)
# ---------------------------------------------------------------------------
# scripts/bootstrap-admin.mjs lo crea después de cada `npm run db:reset`, con
# la contraseña ya definida (sin cambio obligatorio). En hosted el bootstrap
# se corre con --temporary: genera una contraseña temporal y la imprime una vez.
DEV_ADMIN_EMAIL=admin@lonqui.test
DEV_ADMIN_PASSWORD=
DEV_ADMIN_NAME=Admin de desarrollo

# ---------------------------------------------------------------------------
# Resend (no se usa en la Fase 1)
# ---------------------------------------------------------------------------
# La Fase 1 no manda mails: los usuarios se crean con contraseña temporal y
# un admin la restablece si alguien se la olvida. Quedan para la Fase 5
# (recordatorios de cuota).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Club Naranja y Blanco
